PORT=5000
MONGODB_URI=
# Websites allowed to call the API (CORS). Several are allowed, separated by commas.
# On Render: https://<your-client>.onrender.com,http://localhost:5173
CLIENT_URL=http://localhost:5173
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
PAGESPEED_API_KEY=
PAYPAL_MOCK=false
# Optional: the only worker email allowed (the sandbox business account that owns the PayPal app).
# PayPal can only cancel (void) holds for that account. Empty = any email is accepted.
PAYPAL_WORKER_EMAIL=
# Checker loop on/off. Only one server per database should run it:
# once Render is live, set false on laptops.
CHECKER_LOOP=false
# "interaction" checklist items (PLAN.md 5.3): true = the AI may write them. Anything else = off.
# Jobs that already have one are checked either way.
INTERACTION_CHECKS=true
DNS_SERVERS=
