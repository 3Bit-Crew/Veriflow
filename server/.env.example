PORT=5000
MONGODB_URI=
# Websites allowed to call the API (CORS). Several are allowed, separated by commas.
# On Render: https://<your-client>.onrender.com,http://localhost:5173
CLIENT_URL=http://localhost:5173
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
PAGESPEED_API_KEY=
PAYPAL_MOCK=false
# Checker loop on/off. Only one server per database should run it:
# once Render is live, set false on laptops.
CHECKER_LOOP=true
DNS_SERVERS=
